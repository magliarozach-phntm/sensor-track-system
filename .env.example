# --------------------------------------------------
# DATABASE
# --------------------------------------------------
# Host-side development connects to the Docker
# PostgreSQL container through localhost:5433.
#
# Docker Compose overrides DB_HOST and DB_PORT for
# the backend container to use db:5432.

DB_USER=postgres
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=5433
DB_NAME=sensor_track_db


# --------------------------------------------------
# APPLICATION
# --------------------------------------------------

APP_ENV=development
SQL_ECHO=false


# --------------------------------------------------
# CORS
# --------------------------------------------------

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080"]


# --------------------------------------------------
# SYNTHETIC SENSOR SIMULATOR
# --------------------------------------------------

SENSOR_API_URL=http://127.0.0.1:8000